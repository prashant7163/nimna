# nimna-relay configuration — systemd EnvironmentFile syntax (KEY=value,
# no `export`, no shell expansion). Install as /etc/nimna-relay/relay.env,
# owner root:nimna-relay, mode 0640.
#
# Every knob is also a flag on the binary; the flag wins over the env var.
# Empty values behave like unset. Spec-named numbers ship spec-verbatim as
# built-in defaults — a line here is only needed to CHANGE one, so the
# limit lines below are commented out at their defaults.
#
# CREDENTIALS ARE DEPLOYMENT CONFIGURATION, NEVER REPOSITORY CONTENT
# (spec §4): the push and TLS slots below ship EMPTY; fill them on the
# host only.

# --- listeners -----------------------------------------------------------

# Public WebSocket listener. Production: :443 (the unit grants
# CAP_NET_BIND_SERVICE). The binary's built-in default is 127.0.0.1:9440.
NIMNA_RELAY_LISTEN=:443

# Ops listener: GET /metrics and GET /healthz, operator-local ONLY.
# Never expose this publicly — scrape via SSH tunnel (RUNBOOK.md §9).
# Empty disables it.
NIMNA_RELAY_METRICS_LISTEN=127.0.0.1:9441

# --- TLS (both-or-neither; one alone is boot-fatal) -----------------------

# PEM paths as maintained by the certbot deploy hook
# (certbot-deploy-hook.sh): /etc/nimna-relay/tls/fullchain.pem and
# /etc/nimna-relay/tls/privkey.pem. The relay hot-reloads a renewed
# certificate within ~60 s (mtime-checked) — renewal never restarts it.
# Both empty = plain listener (dev / tunnel-terminated only).
NIMNA_RELAY_TLS_CERT=
NIMNA_RELAY_TLS_KEY=

# --- push credentials (spec §3.2.1; all slots EMPTY = push-less) ----------

# APNs: all four slots go together — a partial set is boot-fatal.
# Key file: the .p8 under /etc/nimna-relay/credentials/, root:nimna-relay
# 0640. The .p8 must parse at boot.
NIMNA_RELAY_APNS_KEY_FILE=
NIMNA_RELAY_APNS_KEY_ID=
NIMNA_RELAY_APNS_TEAM_ID=
NIMNA_RELAY_APNS_TOPIC=

# FCM: service-account JSON path (supplies client_email, private_key,
# token_uri, project_id). Must parse at boot.
NIMNA_RELAY_FCM_SA_FILE=

# One-platform deployments are legal: dispatches for the unconfigured
# platform are silently dropped (counted in metrics). Self-hosters without
# platform credentials run push-less — everything else works identically.

# --- limits (spec §4; built-in defaults shown — uncomment to change) ------

#NIMNA_RELAY_MAX_CONNS_PER_IP=64
#NIMNA_RELAY_FRAME_RATE=50
#NIMNA_RELAY_FRAME_BURST=100
#NIMNA_RELAY_MAX_FRAME=131072
#NIMNA_RELAY_RENDEZVOUS_PER_MIN=6
#NIMNA_RELAY_MAX_REGS_PER_CONN=256
#NIMNA_RELAY_KNOCK_INTERVAL=10s
#NIMNA_RELAY_PUSH_MIN_INTERVAL=60s
#NIMNA_RELAY_PUSH_PER_HOUR=6
#NIMNA_RELAY_PUSH_PER_DAY=20
#NIMNA_RELAY_PUSH_HOUR_WINDOW=1h
#NIMNA_RELAY_PUSH_DAY_WINDOW=24h
#NIMNA_RELAY_IDLE_TIMEOUT=90s

# --- never in production ---------------------------------------------------

# Test-only HTTP push sink; boot-fatal combined with any real credential.
#NIMNA_RELAY_PUSH_SINK=

# Per-connection debug tracing. NEVER in production.
#NIMNA_RELAY_DEBUG_TRACE=false
