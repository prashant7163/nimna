# nimna-relay systemd unit (architecture note §28).
#
# The statelessness claim as a unit property: ProtectSystem=strict with NO
# StateDirectory, no CacheDirectory, no LogsDirectory, and no
# ReadWritePaths — the service structurally cannot write to the filesystem
# at all. An auditor reads zero-at-rest off this file in one line; the
# relay's complete at-rest inventory (spec §4) is memory tables, the TLS
# certificate pair, and the push-credential files — all read-only here.
#
# Install: /etc/systemd/system/nimna-relay.service
# Requires: the nimna-relay system user, /etc/nimna-relay/relay.env, and
# the binary at /usr/local/bin/nimna-relay — see RUNBOOK.md.

[Unit]
Description=nimna relay — stateless E2E-ciphertext router
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Dedicated system user — not DynamicUser: certbot-renewed certificates
# and credential files need stable ownership a deploy hook can chown to;
# ephemeral UIDs cannot own files across restarts.
User=nimna-relay
Group=nimna-relay
ExecStart=/usr/local/bin/nimna-relay
EnvironmentFile=/etc/nimna-relay/relay.env

# Port 443 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening set (pinned, §28).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Go does not JIT; W^X costs nothing.
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

LimitNOFILE=65536
# Restart is always safe — the relay is stateless; live pairs re-knock.
Restart=always

[Install]
WantedBy=multi-user.target
