{
  "$meta": {
    "name": "nimna-design-tokens",
    "version": "1.0.0",
    "direction": "C — The Line",
    "note": "Colors are 8-digit ARGB-ready hex without alpha unless stated. Map 1:1 into Flutter ThemeData / ThemeExtension. Sizes in logical px (Flutter dp).",
    "wcag": "All text/background pairings AA-verified; see designs/brand/color-system.md"
  },
  "color": {
    "dark": {
      "surface0": "#0B0B0C",
      "surface1": "#141416",
      "surface2": "#1B1B1E",
      "surface3": "#232327",
      "hairline": "#26262A",
      "textPrimary": "#E8E6E1",
      "textSecondary": "#A8A6A0",
      "textTertiary": "#7C7A75",
      "textDisabled": "#55534F",
      "accent": "#F2A65A",
      "accentPressed": "#DE8F3E",
      "accentGlow": "#F2A65A24",
      "onAccent": "#201305",
      "lineIdle": "#6E6E74",
      "lineLive": "#F2A65A",
      "danger": "#E0655A",
      "dangerFill": "#8C2F27",
      "onDanger": "#FFF6F5",
      "warning": "#CBA35C",
      "bubbleSent": "#26201A",
      "bubbleReceived": "#1D1D20",
      "scrim": "#00000099"
    },
    "light": {
      "surface0": "#F7F5F2",
      "surface1": "#FFFFFF",
      "surface2": "#FFFFFF",
      "surface3": "#FFFFFF",
      "hairline": "#E5E2DC",
      "textPrimary": "#1C1B19",
      "textSecondary": "#57544E",
      "textTertiary": "#6F6B62",
      "textDisabled": "#B0ACA4",
      "accent": "#96581A",
      "accentPressed": "#7C4813",
      "accentGlow": "#96581A1A",
      "onAccent": "#FFFFFF",
      "lineIdle": "#827F78",
      "lineLive": "#96581A",
      "danger": "#A6362C",
      "dangerFill": "#A6362C",
      "onDanger": "#FFFFFF",
      "warning": "#8A6B3A",
      "bubbleSent": "#F3E8DA",
      "bubbleReceived": "#FFFFFF",
      "scrim": "#00000059"
    }
  },
  "typography": {
    "fontFamily": "Schibsted Grotesk",
    "fontFamilyMono": "Spline Sans Mono",
    "styles": {
      "display":     { "size": 32, "lineHeight": 40, "weight": 500, "letterSpacing": -0.4 },
      "title1":      { "size": 24, "lineHeight": 31, "weight": 500, "letterSpacing": -0.2 },
      "title2":      { "size": 20, "lineHeight": 26, "weight": 500, "letterSpacing": -0.1 },
      "bodyLarge":   { "size": 17, "lineHeight": 25, "weight": 400, "letterSpacing": 0 },
      "body":        { "size": 15, "lineHeight": 22, "weight": 400, "letterSpacing": 0 },
      "label":       { "size": 15, "lineHeight": 20, "weight": 500, "letterSpacing": 0.1 },
      "caption":     { "size": 13, "lineHeight": 18, "weight": 400, "letterSpacing": 0.1 },
      "micro":       { "size": 11, "lineHeight": 15, "weight": 500, "letterSpacing": 0.6, "uppercase": true },
      "codeDisplay": { "size": 28, "lineHeight": 36, "weight": 500, "letterSpacing": 6, "mono": true },
      "codeInline":  { "size": 17, "lineHeight": 24, "weight": 500, "letterSpacing": 2, "mono": true }
    }
  },
  "spacing": {
    "base": 4,
    "scale": [4, 8, 12, 16, 20, 24, 32, 40, 48, 64],
    "screenMargin": 20,
    "listRowChannel": 72,
    "listRowSettings": 56,
    "touchTargetMin": 44
  },
  "radius": {
    "small": 10,
    "medium": 14,
    "large": 16,
    "sheet": 20,
    "full": 999,
    "bubbleTail": 4
  },
  "elevation": {
    "darkMode": "surface-steps, no shadows",
    "lightShadowSm": "0 1 2 #0000000F",
    "lightShadowMd": "0 4 12 #00000014",
    "lightShadowLg": "0 12 32 #0000001F"
  },
  "motion": {
    "durMicroMs": 120,
    "durStandardMs": 200,
    "durEnterMs": 320,
    "durBreathMs": 2800,
    "durWipeCutMs": 480,
    "easeStandard": [0.4, 0, 0.2, 1],
    "easeDecelerate": [0.2, 0, 0, 1],
    "springs": "forbidden"
  },
  "line": {
    "thickness": 2,
    "dotGapIdle": [2, 7],
    "endpointRadius": 3,
    "holdToWipeChannelMs": 1500,
    "holdToWipeFullMs": 2500
  }
}
